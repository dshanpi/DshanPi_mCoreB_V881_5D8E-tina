/* audio dirver module -> audio codec */
&codec {
	tx-hub-en;
	rx-sync-en;

	dac-vol		= <32>;		/* default value:32 range:0->63 */
	dacl-vol	= <129>;	/* default value:129 range:0->255 */
	adc1-vol	= <129>;	/* default value:129 range:0->255 */
	adc2-vol	= <129>;	/* default value:129 range:0->255 */
	lineoutl-vol	= <7>;		/* default value:7 range:0->7 */
	adc1-gain	= <15>;		/* default value:15 range:0->15 */
	adc2-gain	= <15>;		/* default value:15 range:0->15 */

	pa-pin-max	= <1>;
	pa-pin-0	= <&pio PH 12 GPIO_ACTIVE_HIGH>;
	pa-pin-level-0	= <1>;
	pa-pin-msleep-0	= <0>;

	status = "okay";
};

&codec_plat {
	playback-cma	= <32>;
	capture-cma	= <32>;
	status = "okay";
};

&codec_mach {
	status = "okay";
	soundcard-mach,cpu {
		sound-dai = <&codec_plat>;
	};
	soundcard-mach,codec {
		sound-dai = <&codec>;
	};
};

/* audio dirver module -> I2S/PCM */
&i2s0_plat {
	tdm-num		= <0>;
	tx-pin		= <0>;
	rx-pin		= <0>;

	pinctrl-used;
	pinctrl-names	= "default","sleep";

	/* default not use i2s pins for rproc rtos uart mux */
	/* pinctrl-0	= <&i2s0_pins_a &i2s0_pins_b &i2s0_pins_c &i2s0_pins_d &i2s0_pins_e>; */
	/* pinctrl-1	= <&i2s0_pins_f>; */
	pinctrl-0	= <>;
	pinctrl-1	= <>;

	tx-hub-en;
	rx-sync-en;
	playback-cma	= <32>;
	capture-cma	= <32>;
	status		= "okay";
};

&i2s0_mach {
	soundcard-mach,format		= "i2s";

	soundcard-mach,name		= "sndi2s0";
	soundcard-mach,frame-master	= <&i2s0_cpu>;
	soundcard-mach,bitclock-master	= <&i2s0_cpu>;
	/* soundcard-mach,frame-inversion; */
	/* soundcard-mach,bitclock-inversion; */
	soundcard-mach,slot-num		= <2>;
	soundcard-mach,slot-width	= <32>;
	status		= "okay";
	i2s0_cpu: soundcard-mach,cpu {
		sound-dai = <&i2s0_plat>;
		/* note: pll freq = 24.576M or 22.5792M * pll-fs */
		soundcard-mach,pll-fs	= <1>;
		/* note:
		 * mclk freq = mclk-fs * 12.288M or 11.2896M	(when mclk-fp ture)
		 * mclk freq = mclk-fs * pcm rate		(when mclk-fp false)
		 */
		soundcard-mach,mclk-fp;
		soundcard-mach,mclk-fs	= <1>;
	};

	i2s0_codec: soundcard-mach,codec {
	};
};

&rfkill {
	compatible = "allwinner,sunxi-rfkill";
	chip_en;
	power_en;
	pinctrl-0;
	pinctrl-names;
	status = "okay";

	/* wlan session */
	wlan {
		compatible    = "allwinner,sunxi-wlan";
		wlan_busnum   = <0x1>;
		wlan_regon    = <&pio PE 9 GPIO_ACTIVE_HIGH>;
		wlan_hostwake = <&pio PG 7 GPIO_ACTIVE_HIGH>;
		wakeup-source;
	};

	/* bt session */
	bt {
		compatible    = "allwinner,sunxi-bt";
		bt_rst_n      = <&pio PE 8 GPIO_ACTIVE_LOW>;
		status        = "okay";
	};

};

&btlpm {
	compatible = "allwinner,sunxi-btlpm";
	uart_index = <0x2>;
	bt_wake = <&pio PE 7 GPIO_ACTIVE_HIGH>;
	bt_hostwake = <&pio PE 6 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&addr_mgt {
	compatible = "allwinner,sunxi-addr_mgt";
	type_addr_wifi = <0x0>;
	type_addr_bt   = <0x0>;
	type_addr_eth  = <0x0>;
	status = "okay";
};

&mdio0 {
	status = "disabled";
	gmac0_phy0: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		/* RTL8201F */
		reg = <0>;
		max-speed = <100>;
		reset-gpios = <&pio PH 3 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <150000>;
	};
};

&gmac0 {
	phy-mode = "rmii";
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&gmac_pins_a>;
	pinctrl-1 = <&gmac_pins_b>;
	sunxi,phy-clk-type = <0>;
	tx-delay = <0>;
	rx-delay = <0>;
	phy-handle = <&gmac0_phy0>;
	status = "disabled";
	gmac3v3-supply = <&reg_dcdc1>;
};




/* VE enc freq 576M uses pll-video-4x as parent; set to 1152M (576*2)
 * so VE can do integer division. Otherwise VE changing parent
 * clock frequency may disturb TCON frame rate. */
&ccu {
	assigned-clocks = <&ccu CLK_PLL_VIDEO_4X>;
	assigned-clock-rates = <1152000000>;
};

&dram {
	dram_para00 = <1056>;
	dram_para01 = <3>;
	dram_para02 = <0x7b6bfb>;
	dram_para03 = <0x1>;
	dram_para04 = <0x000010d2>;
	dram_para05 = <0x00000000>;
	dram_para06 = <0x1c70>;
	dram_para07 = <0x2>;
	dram_para08 = <0x18>;
	dram_para09 = <0x0>;
	dram_para10 = <0x004A2195>;
	dram_para11 = <0x02423190>;
	dram_para12 = <0x0008B061>;
	dram_para13 = <0xB4787896>;
	dram_para14 = <0x0>;
	dram_para15 = <0x48484848>;
	dram_para16 = <0x48>;
	dram_para17 = <0x1621121e>;
	dram_para18 = <0x0>;
	dram_para19 = <0x0>;
	dram_para20 = <0x0>;
	dram_para21 = <0x00460000>;
	dram_para22 = <0x00000055>;
	dram_para23 = <0x34010100>;
};

&pmc {
	pmc_irq_boot_en = <1>;
	pmc_irq_en = <1>;
	pmc_alarm_waleup_en = <0>;
	pmc_on2off_extra_en = <0>;
	pmc_vbus_wakeup_en = <0>;
	pmc_vbus_control_en = <0>;
	pmc_boot_seq = <0>;
	pmc_hw_clk_gating = <0>;
	wup_timer_wake_en = <1>;
	status = "okay";
};

&pmc_powerkey {
	pmu_powkey_off_time = <6000>;
	pmu_powkey_off_func = <0>;
	pmu_powkey_off_en = <1>;
	pmu_powkey_long_time = <1500>;
	pmu_powkey_on_time = <512>;
	wakeup_rising;
	status = "okay";
};

&pmc_usb_power_supply {
	pmu_usbpc_vol = <4600>;
	pmu_usbpc_cur = <500>;
	pmu_usbad_vol = <4600>;
	pmu_usbad_cur = <2500>;
	wakeup_usb_in;
	wakeup_usb_out;
	status = "okay";
};
